            "All", "Africa", "Asia", "Australia & New Zealand", "Europe", "LATAM", "Middle East", "UK & Ireland", "US & Canada", "Worldwide"
        ];
        
        // --- Shared Components ---
        
        const GeminiModal = ({ title, content, show, onClose, isJson, children }) => {
            if (!show) return null;
            return (
                <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex justify-center items-center p-4" onClick={(e) => e.target === e.currentTarget && onClose()}>
                    <div className="bg-white rounded-lg shadow-2xl w-full max-w-2xl max-h-full overflow-y-auto">
                        <div className="p-6">
                            <div className="flex justify-between items-center mb-4">
                                <h3 className="text-xl font-bold text-gray-800">{title}</h3>
                                <button onClick={onClose} className="text-gray-400 hover:text-gray-600">
                                    <i className="icon icon-xmark"></i>
                                </button>
                            </div>
                            {children ? children : (
                                isJson ? (
                                    <pre className="bg-gray-900 text-white p-4 rounded-md text-sm whitespace-pre-wrap break-all">
                                        <code>{content}</code>
                                    </pre>
                                ) : (
                                    <p className="text-gray-600 whitespace-pre-wrap">{content}</p>
                                )
                            )}
                        </div>
                    </div>
                </div>
            );
        };

        const Toast = ({ message, type, show, onClose }) => {
            const [isVisible, setIsVisible] = useState(false);
            useEffect(() => {
                if (show) {
                    setIsVisible(true);
                    const timer = setTimeout(() => {
                        setIsVisible(false);
                        setTimeout(onClose, 300);
                    }, 3000);
                    return () => clearTimeout(timer);
                } else {
                    setIsVisible(false);
                }
            }, [show, onClose]);
            if (!message) return null;
            const bgColor = type === 'success' ? 'bg-green-600' : 'bg-red-600';
            return (
                <div className={`fixed top-5 left-1/2 -translate-x-1/2 z-[100] transition-all duration-300 ${isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-10'}`}>
                    <div className={`${bgColor} text-white font-bold py-3 px-6 rounded-lg shadow-xl`}>
                        <p>{message}</p>
                    </div>
                </div>
            );
        };

        const OmniSearchBar = (props) => {
            const { filtersActive, onResetFilters, searchTerm, onSearchChange, handleDomainChange } = props;
            const [isFilterOpen, setFilterOpen] = useState(false);
            const searchRef = useRef(null);

            return (
                <div className="relative w-full mb-8" ref={searchRef}>
                    <div className="relative">
                        <input
                            type="text"
                            placeholder="Search for banking features..."
                            onFocus={() => setFilterOpen(true)}
                            value={searchTerm}
                            onChange={(e) => { onSearchChange(e.target.value); if(e.target.value) setFilterOpen(false); }}
                            className="w-full pl-4 pr-12 py-3 bg-white border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                        />
                        <div className="absolute inset-y-0 right-0 flex items-center pr-3 cursor-pointer" onClick={() => setFilterOpen(!isFilterOpen)}>
                             <i className="icon icon-magnifying-glass text-gray-400"></i>
                        </div>
                    </div>
                    {isFilterOpen && !searchTerm && (
                        <div className="absolute top-full mt-2 w-full bg-white rounded-lg shadow-xl border z-40 p-6">
                            <div className="flex justify-between items-center mb-6 pb-4 border-b">
                                <h2 className="text-xl font-bold text-gray-800">Filters</h2>
                                {filtersActive && (
                                    <button onClick={onResetFilters} className="text-sm text-blue-600 font-semibold">Reset All</button>
                                )}
                            </div>
                            <div className="max-h-[60vh] overflow-y-auto">
                                <div className="mb-4">
                                    <h3 className="text-sm font-bold text-gray-600 mb-2 uppercase">Domain</h3>
                                    <div className="flex flex-wrap gap-2">
                                        {financialServicesData.map(d => (
                                            <button key={d.domainId} onClick={() => handleDomainChange(d.domainId)} className={`px-3 py-1 rounded-full border text-sm ${props.selectedDomainId === d.domainId ? 'bg-blue-600 text-white' : 'bg-white'}`}>
                                                {d.domainName}
                                            </button>
                                        ))}
                                    </div>
                                </div>
                            </div>
                            <button onClick={() => setFilterOpen(false)} className="w-full mt-4 bg-blue-600 text-white py-2 rounded-lg font-bold">Apply Filters</button>
                        </div>
                    )}
                </div>
            );
        };

        const ApiSpecTable = ({ specs, useCase, domainId, selectedLocations }) => {
            return (
                <div className="mt-4 overflow-x-auto">
                    <table className="min-w-full bg-white border border-gray-200 rounded-lg">
                        <thead className="bg-gray-50">
                            <tr>
                                <th className="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase w-3/5">Feature</th>
                                <th className="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase w-1/5">Connector</th>
                                <th className="px-4 py-2 text-left text-xs font-semibold text-gray-600 uppercase w-1/5">Status</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-200 text-sm">
                            {specs.map((spec, i) => {
                                const relevantLoc = spec.locationSpecificData?.filter(d => selectedLocations.includes('All') || selectedLocations.includes(d.location));
                                const cons = Array.from(new Set(relevantLoc?.flatMap(l => l.connectors))).join(', ');
                                return (
                                    <tr key={i}>
                                        <td className="px-4 py-3">
                                            <div className="font-medium text-gray-800">{spec.subFeature}</div>
                                            <div className="text-xs text-gray-500 font-mono">{spec.method} {spec.path}</div>
                                        </td>
                                        <td className="px-4 py-3 text-gray-600">{cons || 'N/A'}</td>
                                        <td className="px-4 py-3">
                                            <span className={`px-2 py-0.5 rounded-full text-xs font-bold ${spec.status === 'Done' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}`}>
                                                {spec.status}
                                            </span>
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            );
        };

        const UseCaseCard = ({ capability, domain, selectedLocations, isExpanded, toggleExpansion }) => (
            <div className="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden mb-4">
                <button onClick={toggleExpansion} className="w-full text-left p-6 flex justify-between items-center focus:outline-none bg-white hover:bg-gray-50 transition-colors">
                    <div>
                        <h3 className="text-xl font-bold text-gray-900">{capability.name}</h3>
                        <p className="text-sm text-gray-500">{capability.description}</p>
                    </div>
                    <i className={`icon icon-chevron-down text-gray-400 transition-transform ${isExpanded ? 'rotate-180' : ''}`}></i>
                </button>
                {isExpanded && (
                    <div className="p-6 border-t border-gray-100 bg-gray-50">
                        {capability.useCases.map((uc, i) => (
                            <div key={i} className="mb-6 last:mb-0">
                                <h4 className="font-bold text-gray-700 mb-2 flex items-center gap-2">
                                    {uc.name} 
                                    <span className="text-xs font-normal text-gray-400">({uc.sector.join('/')})</span>
                                </h4>
                                <ApiSpecTable specs={uc.apiSpecs} useCase={uc} domainId={domain.domainId} selectedLocations={selectedLocations} />
                            </div>
                        ))}
                    </div>
                )}
            </div>
        );

        const DomainExplorer = ({ showToast, financialData }) => {
            const [selectedDomainId, setSelectedDomainId] = useState('payments');
            const [selectedLocations, setSelectedLocations] = useState(['All']);
            const [expandedStates, setExpandedStates] = useState({});
            const [searchTerm, setSearchTerm] = useState('');

            const currentDomainData = financialData.find(d => d.domainId === selectedDomainId);
            
            const handleDomainChange = (id) => {
                setSelectedDomainId(id);
                setExpandedStates({});
            };

            const toggleCap = (id) => {
                setExpandedStates(prev => ({ ...prev, [id]: !prev[id] }));
            };

            return (
                <div>
                    <OmniSearchBar 
                        selectedDomainId={selectedDomainId} 
                        handleDomainChange={handleDomainChange}
                        searchTerm={searchTerm}
                        onSearchChange={setSearchTerm}
                        onResetFilters={() => {setSearchTerm(''); setSelectedLocations(['All']);}}
                    />
                    <div className="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                        <div className="md:col-span-1 space-y-6">
                            <div className="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                                <h3 className="text-sm font-bold text-gray-500 uppercase mb-4 tracking-wider">Active Domain</h3>
                                <div className="space-y-2">
                                    {financialData.map(d => (
                                        <button 
                                            key={d.domainId}
                                            onClick={() => handleDomainChange(d.domainId)}
                                            className={`w-full text-left px-4 py-2 rounded-lg text-sm font-semibold transition-all ${selectedDomainId === d.domainId ? 'bg-blue-600 text-white shadow-md' : 'text-gray-700 hover:bg-gray-100'}`}
                                        >
                                            {d.domainName}
                                        </button>
                                    ))}
                                </div>
                            </div>
                            <div className="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                                <h3 className="text-sm font-bold text-gray-500 uppercase mb-4 tracking-wider">Geography</h3>
                                <select 
                                    className="w-full border-gray-300 rounded-lg text-sm focus:ring-blue-500"
                                    value={selectedLocations[0]}
                                    onChange={(e) => setSelectedLocations([e.target.value])}
                                >
                                    {locations.map(l => <option key={l} value={l}>{l}</option>)}
                                </select>
                            </div>
                        </div>
                        <div className="md:col-span-3">
                            <div className="mb-6">
                                <h2 className="text-2xl font-extrabold text-gray-900">{currentDomainData.title}</h2>
                                <p className="text-gray-600 mt-1">{currentDomainData.description}</p>
                            </div>
                            {currentDomainData.capabilities.map(cap => (
                                <UseCaseCard 
                                    key={cap.id} 
                                    capability={cap} 
                                    domain={currentDomainData} 
                                    selectedLocations={selectedLocations}
                                    isExpanded={expandedStates[cap.id] !== false}
                                    toggleExpansion={() => toggleCap(cap.id)}
                                />
                            ))}
                        </div>
                    </div>
                </div>
            );
        };

        function App() {
            const [activeView, setActiveView] = useState('explorer');
            const [isEditor, setIsEditor] = useState(() => sessionStorage.getItem('isEditor') === 'true');
            const [showLogin, setShowLogin] = useState(false);
            const [password, setPassword] = useState('');
            const [toast, setToast] = useState({ show: false, message: '', type: 'success' });

            const showToast = (message, type = 'success') => setToast({ show: true, message, type });

            const handleLogin = (e) => {
                e.preventDefault();
                if (password === 'admin123') {
                    setIsEditor(true);
                    sessionStorage.setItem('isEditor', 'true');
                    setShowLogin(false);
                    showToast('Editor access granted');
                } else {
                    showToast('Invalid password', 'error');
                }
            };

            return (
                <div className="min-h-screen flex flex-col">
                    <Toast {...toast} onClose={() => setToast(p => ({...p, show: false}))} />
                    
                    <header className="bg-white border-b border-gray-200 sticky top-0 z-40">
                        <div className="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
                            <div className="flex items-center gap-8">
                                <span className="logo-text">Platform Domain Dashboard</span>
                                <nav className="hidden md:flex gap-1">
                                    <button onClick={() => setActiveView('explorer')} className={`navigation-item ${activeView === 'explorer' ? 'active' : ''}`}>Explorer</button>
                                    {isEditor && <button onClick={() => setActiveView('interactions')} className={`navigation-item ${activeView === 'interactions' ? 'active' : ''}`}>Interactions</button>}
                                    <button onClick={() => setActiveView('releaseNotes')} className={`navigation-item ${activeView === 'releaseNotes' ? 'active' : ''}`}>Release Notes</button>
                                </nav>
                            </div>
                            <div className="flex items-center gap-4">
                                {isEditor ? (
                                    <button onClick={() => {setIsEditor(false); sessionStorage.removeItem('isEditor'); setActiveView('explorer');}} className="text-xs font-bold text-red-600 uppercase border border-red-200 px-3 py-1 rounded hover:bg-red-50">Exit Editor</button>
                                ) : (
                                    <button onClick={() => setShowLogin(true)} className="text-xs font-bold text-gray-500 uppercase border border-gray-200 px-3 py-1 rounded hover:bg-gray-50">Editor Login</button>
                                )}
                            </div>
                        </div>
                    </header>

                    <main className="flex-grow max-w-7xl mx-auto px-4 py-8 w-full">
                        {activeView === 'explorer' && <DomainExplorer financialData={financialServicesData} showToast={showToast} />}
                        {activeView === 'releaseNotes' && <ReleaseNotes />}
                        {activeView === 'interactions' && (
                            <div className="bg-white p-8 rounded-xl shadow-sm border border-gray-200 text-center">
                                <h2 className="text-2xl font-bold mb-4">Domain Interoperability Matrix</h2>
                                <p className="text-gray-500 italic">Advanced interaction mapping is available in this restricted view.</p>
                                <div className="mt-8 overflow-x-auto">
                                    <table className="w-full border-collapse border border-gray-200">
                                        <thead>
                                            <tr className="bg-gray-50">
                                                <th className="border border-gray-200 p-2"></th>
                                                {financialServicesData.map(d => <th key={d.domainId} className="border border-gray-200 p-2 text-xs">{d.domainName}</th>)}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {financialServicesData.map(rd => (
                                                <tr key={rd.domainId}>
                                                    <td className="border border-gray-200 p-2 text-xs font-bold bg-gray-50">{rd.domainName}</td>
                                                    {financialServicesData.map(cd => {
                                                        const match = domainInteractions.find(i => (i.source === rd.domainId && i.target === cd.domainId) || (i.source === cd.domainId && i.target === rd.domainId));
                                                        return <td key={cd.domainId} className="border border-gray-200 p-2 text-center">{match && rd.domainId !== cd.domainId ? '🔵' : ''}</td>;
                                                    })}
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        )}
                    </main>

                    {showLogin && (
                        <div className="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
                            <form onSubmit={handleLogin} className="bg-white p-8 rounded-xl shadow-2xl w-full max-w-sm">
                                <h3 className="text-xl font-bold mb-4">Editor Access</h3>
                                <input 
                                    type="password" 
                                    placeholder="Enter password (admin123)"
                                    className="w-full border-gray-300 rounded-lg mb-4"
                                    value={password}
                                    onChange={e => setPassword(e.target.value)}
                                    autoFocus
                                />
                                <div className="flex gap-2">
                                    <button type="button" onClick={() => setShowLogin(false)} className="flex-1 px-4 py-2 border rounded-lg">Cancel</button>
                                    <button type="submit" className="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg font-bold">Login</button>
                                </div>
                            </form>
                        </div>
                    )}

                    <footer className="bg-white border-t border-gray-200 py-6 mt-12">
                        <div className="max-w-7xl mx-auto px-4 text-center text-gray-400 text-sm">
                            © 2026 Financial Services Architecture Platform. Internal Use Only.
                        </div>
                    </footer>
                </div>
            );
        }

        const ReleaseNotes = () => (
            <div className="max-w-3xl mx-auto">
                <h2 className="text-3xl font-bold mb-8">Release History</h2>
                <div className="space-y-8">
                    {releaseNotesData.map(note => (
                        <div key={note.id} className="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                            <div className="flex justify-between items-start mb-2">
                                <span className="text-xs font-bold uppercase tracking-widest text-blue-600">{note.version}</span>
                                <span className="text-xs text-gray-400">{note.date}</span>
                            </div>
                            <h3 className="text-xl font-bold mb-2">{note.title}</h3>
                            <p className="text-gray-600 text-sm leading-relaxed">{note.description}</p>
                            <div className="mt-4 pt-4 border-t border-gray-50 flex items-center gap-2 text-xs text-gray-400">
                                <i className="icon icon-circle-info"></i> By {note.author}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        );

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
